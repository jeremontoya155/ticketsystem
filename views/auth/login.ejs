<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar Sesión | TicketSystem</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body class="login-page">
  <div class="login-atmosphere" aria-hidden="true">
    <span class="orb orb-a"></span>
    <span class="orb orb-b"></span>
    <span class="orb orb-c"></span>
    <span class="signal-line signal-one"></span>
    <span class="signal-line signal-two"></span>
    <span class="signal-line signal-three"></span>
  </div>
  <div class="login-container">
    <div class="login-box">
      <div class="login-specimen" aria-hidden="true">
        <span>OV-DLR</span>
        <span>ACCESS 01</span>
      </div>
      <div class="login-logo">
        <i class="fas fa-ticket-alt"></i>
        <h1>TicketSystem</h1>
        <p>Sistema de gestión de soporte</p>
      </div>
      <% if (error && error.length) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error[0] %></div>
      <% } %>
      <% if (success && success.length) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success[0] %></div>
      <% } %>
      <form action="/login" method="POST" class="login-form">
        <div class="form-group">
          <label><i class="fas fa-envelope"></i> Email</label>
          <input type="email" name="email" placeholder="usuario@empresa.com" required autofocus>
        </div>
        <div class="form-group">
          <label><i class="fas fa-lock"></i> Contraseña</label>
          <input type="password" name="password" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn-primary btn-full">
          <i class="fas fa-sign-in-alt"></i> Ingresar
        </button>
      </form>
      <div class="login-hint">
        <small><strong>Demo:</strong> admin@empresa.com / password</small>
      </div>
    </div>
  </div>
</body>
</html>
