<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <a href="/tickets" class="btn-back"><i class="fas fa-arrow-left"></i> Volver</a>
    <h1><i class="fas fa-envelope-open-text"></i> Intake de Mail</h1>
    <p class="subtitle">Trae los ultimos correos de la casilla configurada, detecta cliente por remitente y propone el ticket antes de importarlo.</p>
  </div>
  <button type="button" class="btn-primary" id="loadMailBtn"><i class="fas fa-rotate"></i> Traer mails</button>
</div>

<div class="mail-intake-toolbar">
  <div class="form-group">
    <label><i class="fas fa-layer-group"></i> Cantidad</label>
    <select id="mailLimit" class="form-select">
      <option value="5">5 mails</option>
      <option value="10" selected>10 mails</option>
      <option value="20">20 mails</option>
      <option value="50">50 mails</option>
    </select>
  </div>
  <div class="mail-intake-status" id="mailStatus">Listo para consultar la casilla.</div>
</div>

<div class="mail-intake-grid" id="mailList">
  <div class="empty-state">
    <i class="fas fa-inbox"></i>
    <p>Todavia no se trajeron mails.</p>
  </div>
</div>

<script>
  const mailList = document.getElementById('mailList');
  const mailStatus = document.getElementById('mailStatus');
  const loadMailBtn = document.getElementById('loadMailBtn');
  const mailLimit = document.getElementById('mailLimit');

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderMailCard(mail) {
    const ticket = mail.possibleTicket || {};
    const client = ticket.cliente_detectado;
    const date = mail.date ? new Date(mail.date).toLocaleString('es-AR') : 'Sin fecha';
    const confianza = ticket.confianza || 'baja';
    const score = ticket.score || 0;
    const esPosibleTicket = ticket.es_posible_ticket;
    
    // Clases según confianza
    const cardClass = esPosibleTicket ? `mail-card mail-card-ticket mail-card-${confianza}` : 'mail-card';
    
    // Badge de confianza
    const confianzaBadge = esPosibleTicket ? `
      <span class="confianza-badge confianza-${confianza}" title="Puntaje: ${score}/100">
        <i class="fas fa-${confianza === 'alta' ? 'check-circle' : confianza === 'media' ? 'exclamation-circle' : 'info-circle'}"></i>
        ${confianza === 'alta' ? 'Ticket probable' : confianza === 'media' ? 'Posible ticket' : 'Revisar'}
      </span>
    ` : '';
    
    // Señales detectadas
    const signalsHtml = (ticket.signals || []).length > 0 ? `
      <div class="ticket-signals">
        ${ticket.signals.map(s => `<span class="signal-tag">${escapeHtml(s)}</span>`).join('')}
      </div>
    ` : '';

    return `
      <article class="${cardClass}">
        <div class="mail-card-head">
          <div class="head-left">
            <span class="badge channel-badge canal-mail">Mail</span>
            ${confianzaBadge}
          </div>
          <small>${escapeHtml(date)}</small>
        </div>
        <h3>${escapeHtml(mail.subject)}</h3>
        <div class="mail-from">
          <i class="fas fa-user"></i>
          <span>${escapeHtml(mail.from?.name || 'Sin nombre')} &lt;${escapeHtml(mail.from?.address || '')}&gt;</span>
        </div>
        <p class="mail-preview">${escapeHtml(mail.text)}</p>
        <div class="possible-ticket ${esPosibleTicket ? 'possible-ticket-highlight' : ''}">
          <div class="possible-ticket-header">
            <strong><i class="fas fa-ticket-alt"></i> Análisis de ticket</strong>
            <span class="score-pill">Score: ${score}/100</span>
          </div>
          <div class="possible-ticket-details">
            <span><i class="fas fa-flag"></i> Prioridad: <strong>${escapeHtml(ticket.prioridad_sugerida || 'Media')}</strong></span>
            <span><i class="fas fa-building"></i> ${client ? `Cliente: ${escapeHtml(client.nombre)}` : 'Sin cliente detectado'}</span>
            ${mail.hasAttachments ? `<span><i class="fas fa-paperclip"></i> ${mail.attachmentsCount} adjunto(s)</span>` : ''}
          </div>
          ${signalsHtml}
        </div>
        <button type="button" class="btn-primary btn-full ${esPosibleTicket ? 'btn-import-ticket' : ''}" data-import-mail="${escapeHtml(mail.messageId)}">
          <i class="fas fa-ticket-alt"></i> ${esPosibleTicket ? 'Importar como ticket' : 'Crear ticket desde este mail'}
        </button>
      </article>
    `;
  }

  async function loadMails() {
    loadMailBtn.disabled = true;
    mailStatus.textContent = 'Consultando casilla...';
    mailList.innerHTML = '<div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Trayendo mails...</p></div>';

    try {
      const res = await fetch(`/api/mail/intake/preview?limit=${mailLimit.value}`);
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'No se pudo consultar la casilla');
      if (!data.configured) {
        mailStatus.textContent = data.message || 'Falta configurar IMAP.';
        mailList.innerHTML = `<div class="empty-state"><i class="fas fa-plug-circle-xmark"></i><p>${escapeHtml(data.message || 'Falta configurar IMAP.')}</p></div>`;
        return;
      }
      mailStatus.textContent = `Casilla ${data.mailbox}. ${data.emails.length} mail(s) encontrados.`;
      mailList.innerHTML = data.emails.length
        ? data.emails.map(renderMailCard).join('')
        : '<div class="empty-state"><i class="fas fa-inbox"></i><p>No se encontraron mails.</p></div>';
    } catch (error) {
      mailStatus.textContent = error.message;
      mailList.innerHTML = `<div class="empty-state"><i class="fas fa-triangle-exclamation"></i><p>${escapeHtml(error.message)}</p></div>`;
    } finally {
      loadMailBtn.disabled = false;
    }
  }

  mailList.addEventListener('click', async (event) => {
    const button = event.target.closest('[data-import-mail]');
    if (!button) return;

    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creando ticket...';
    try {
      const res = await fetch('/api/mail/intake/import', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ messageId: button.dataset.importMail, limit: 50 })
      });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'No se pudo importar');
      window.location.href = `/tickets/${data.ticket.id}`;
    } catch (error) {
      button.disabled = false;
      button.innerHTML = '<i class="fas fa-ticket-alt"></i> Crear ticket desde este mail';
      mailStatus.textContent = error.message;
    }
  });

  loadMailBtn.addEventListener('click', loadMails);
</script>

<%- include('../partials/footer') %>
