<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1><i class="fas fa-ticket-alt"></i> Tickets</h1>
    <p class="subtitle">Bandeja centralizada para web, mail, WhatsApp y VFP</p>
  </div>
  <div class="header-actions">
    <% if (user.rol !== 'cliente') { %>
    <form action="/tickets/whatsapp/tomar" method="POST" style="display:inline">
      <button type="submit" class="btn-secondary"><i class="fab fa-whatsapp"></i> Tomar WhatsApp</button>
    </form>
    <% } %>
    <a href="/tickets/nuevo" class="btn-primary"><i class="fas fa-plus"></i> Nuevo Ticket</a>
  </div>
</div>

<!-- Stats Cards -->
<div class="stats-grid">
  <div class="stat-card stat-pending">
    <div class="stat-icon"><i class="fas fa-clock"></i></div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.pendiente %></span>
      <span class="stat-label">Pendientes</span>
    </div>
  </div>
  <div class="stat-card stat-process">
    <div class="stat-icon"><i class="fas fa-spinner"></i></div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.en_proceso %></span>
      <span class="stat-label">En Proceso</span>
    </div>
  </div>
  <div class="stat-card stat-resolved">
    <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.resuelto %></span>
      <span class="stat-label">Resueltos</span>
    </div>
  </div>
  <div class="stat-card stat-alert">
    <div class="stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.alta_prioridad %></span>
      <span class="stat-label">Alta Prioridad</span>
    </div>
  </div>
  <div class="stat-card stat-overdue">
    <div class="stat-icon"><i class="fas fa-fire"></i></div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.vencidos %></span>
      <span class="stat-label">+30 días</span>
    </div>
  </div>
</div>

<!-- Periodo Selector -->
<% if (user.rol !== 'cliente') { %>
<div class="periodo-bar">
  <div class="periodo-selector">
    <label><i class="fas fa-calendar-alt"></i> Período:</label>
    <div class="periodo-buttons">
      <a href="?periodo=7&estado=<%= filters.estado || '' %>&prioridad=<%= filters.prioridad || '' %>&canal=<%= filters.canal || '' %>&buscar=<%= filters.buscar || '' %>" class="periodo-btn <%= filters.periodo == '7' ? 'active' : '' %>">7 días</a>
      <a href="?periodo=30&estado=<%= filters.estado || '' %>&prioridad=<%= filters.prioridad || '' %>&canal=<%= filters.canal || '' %>&buscar=<%= filters.buscar || '' %>" class="periodo-btn <%= !filters.periodo || filters.periodo == '30' ? 'active' : '' %>">30 días</a>
      <a href="?periodo=90&estado=<%= filters.estado || '' %>&prioridad=<%= filters.prioridad || '' %>&canal=<%= filters.canal || '' %>&buscar=<%= filters.buscar || '' %>" class="periodo-btn <%= filters.periodo == '90' ? 'active' : '' %>">90 días</a>
      <a href="?periodo=365&estado=<%= filters.estado || '' %>&prioridad=<%= filters.prioridad || '' %>&canal=<%= filters.canal || '' %>&buscar=<%= filters.buscar || '' %>" class="periodo-btn <%= filters.periodo == '365' ? 'active' : '' %>">1 año</a>
    </div>
  </div>
  <button type="button" class="btn-secondary" id="btnReporteCliente" onclick="document.getElementById('modalReporteCliente').style.display='flex'">
    <i class="fas fa-file-export"></i> Enviar Reporte a Cliente
  </button>
</div>
<% } %>

<!-- Charts Row -->
<div class="charts-row">
  <div class="chart-card">
    <h3><i class="fas fa-chart-doughnut"></i> Por Estado</h3>
    <canvas id="chartEstado" height="200"></canvas>
  </div>
  <div class="chart-card">
    <h3><i class="fas fa-chart-bar"></i> Por Prioridad</h3>
    <canvas id="chartPrioridad" height="200"></canvas>
  </div>
  <div class="chart-card chart-wide">
    <h3><i class="fas fa-chart-line"></i> Tendencia Semanal</h3>
    <canvas id="chartTendencia" height="200"></canvas>
  </div>
</div>

<!-- Filtros -->
<div class="filter-bar">
  <form method="GET" action="/tickets" class="filter-form">
    <div class="filter-group">
      <i class="fas fa-search"></i>
      <input type="text" name="buscar" placeholder="Buscar por cliente, mail, telefono, referencia o #..." value="<%= filters.buscar || '' %>">
    </div>
    <select name="estado">
      <option value="">Todos los estados</option>
      <% ['Pendiente','En Proceso','Resuelto','Cerrado'].forEach(e => { %>
        <option value="<%= e %>" <%= filters.estado === e ? 'selected' : '' %>><%= e %></option>
      <% }) %>
    </select>
    <select name="prioridad">
      <option value="">Toda prioridad</option>
      <% ['Baja','Media','Alta','Urgente'].forEach(p => { %>
        <option value="<%= p %>" <%= filters.prioridad === p ? 'selected' : '' %>><%= p %></option>
      <% }) %>
    </select>
    <select name="canal">
      <option value="">Todos los canales</option>
      <% [['web','Web'],['mail','Mail'],['whatsapp','WhatsApp'],['vfp','VFP']].forEach(([value,label]) => { %>
        <option value="<%= value %>" <%= filters.canal === value ? 'selected' : '' %>><%= label %></option>
      <% }) %>
    </select>
    <select name="periodo">
      <option value="7" <%= filters.periodo == '7' ? 'selected' : '' %>>7 días</option>
      <option value="30" <%= !filters.periodo || filters.periodo == '30' ? 'selected' : '' %>>30 días</option>
      <option value="90" <%= filters.periodo == '90' ? 'selected' : '' %>>90 días</option>
      <option value="365" <%= filters.periodo == '365' ? 'selected' : '' %>>1 año</option>
    </select>
    <button type="submit" class="btn-primary"><i class="fas fa-filter"></i> Filtrar</button>
    <a href="/tickets" class="btn-secondary"><i class="fas fa-times"></i> Limpiar</a>
  </form>
</div>

<!-- Banner de demoras críticas -->
<%
  const _alertThIdx = { 'Urgente':1,'Alta':3,'Media':7,'Baja':14 };
  const _critCount = tickets.filter(t =>
    !['Resuelto','Cerrado'].includes(t.estado) &&
    (t.dias_transcurridos || 0) >= (_alertThIdx[t.prioridad] || 7)
  ).length;
%>
<% if (_critCount > 0) { %>
<div class="delay-alert delay-alert-critical" style="margin-bottom:12px">
  <i class="fas fa-fire-alt"></i>
  <strong><%= _critCount %> ticket<%= _critCount !== 1 ? 's' : '' %> con demora crítica</strong> en esta página — revisalos a continuación (marcados con <i class="fas fa-fire-alt"></i>).
</div>
<% } %>

<!-- Tabla de tickets -->
<div class="table-wrapper">
  <% if (tickets.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-inbox"></i>
      <p>No se encontraron tickets</p>
    </div>
  <% } else { %>
  <table class="data-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Cliente</th>
        <th>Canal</th>
        <th>Reclamo</th>
        <th>Estado</th>
        <th>Prioridad</th>
        <th>Ejecutor</th>
        <th>Días</th>
        <th>Fecha</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% tickets.forEach(t => { %>
      <tr class="ticket-row" onclick="window.location='/tickets/<%= t.id %>'">
        <td data-label="Ticket"><strong class="ticket-num">#<%= t.nro_ticket %></strong></td>
        <td data-label="Cliente">
          <div class="client-cell">
            <span class="client-name"><%= t.cliente_nombre || '—' %></span>
            <small class="tc-badge"><%= t.tc || '' %></small>
          </div>
        </td>
        <td data-label="Canal">
          <% const channel = t.canal_origen || 'web'; %>
          <span class="badge channel-badge canal-<%= channel %>"><%= ({web:'Web',mail:'Mail',whatsapp:'WhatsApp',vfp:'VFP'}[channel] || channel) %></span>
          <% if (t.referencia_externa) { %><small class="muted-line"><%= t.referencia_externa %></small><% } %>
        </td>
        <td data-label="Reclamo"><div class="reclamo-cell"><%= t.reclamo ? t.reclamo.substring(0, 80) + (t.reclamo.length > 80 ? '...' : '') : '—' %></div></td>
        <td data-label="Estado"><span class="badge estado-<%= t.estado.toLowerCase().replace(' ','-') %>"><%= t.estado %></span></td>
        <td data-label="Prioridad"><span class="badge prio-<%= t.prioridad.toLowerCase() %>"><%= t.prioridad %></span></td>
        <td data-label="Ejecutor"><span class="user-pill"><%= t.ejecutor_nombre || '—' %></span></td>
        <td data-label="Días">
          <%
            const _at = { 'Urgente':1,'Alta':3,'Media':7,'Baja':14 };
            const _wt = { 'Urgente':0,'Alta':1,'Media':3,'Baja':7 };
            const _d  = t.dias_transcurridos || 0;
            const _pr = t.prioridad || 'Media';
            const _op = !['Resuelto','Cerrado'].includes(t.estado);
            const _dc = _op && _d >= (_at[_pr] || 7);
            const _dw = _op && !_dc && _d >= (_wt[_pr] || 3);
          %>
          <span class="days-badge <%= _dc ? 'days-critical' : _d > 30 ? 'days-overdue' : _dw ? 'days-warning' : 'days-ok' %>" title="<%= _dc ? 'Demora crítica para prioridad '+_pr : _dw ? 'Demora elevada' : '' %>">
            <% if (_dc) { %><i class="fas fa-fire-alt" style="font-size:10px;margin-right:2px"></i><% } %>
            <%= _d %>d
          </span>
        </td>
        <td data-label="Fecha"><small><%= moment(t.fecha_creacion).format('DD/MM/YY') %></small></td>
        <td data-label="Ver"><button class="btn-icon" onclick="event.stopPropagation(); window.location='/tickets/<%= t.id %>'"><i class="fas fa-eye"></i></button></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<!-- Paginación -->
<% if (pagination.total > 1) { %>
<div class="pagination">
  <% if (pagination.current > 1) { %>
    <a href="?page=<%= pagination.current - 1 %>&estado=<%= filters.estado||'' %>&prioridad=<%= filters.prioridad||'' %>&canal=<%= filters.canal||'' %>&buscar=<%= filters.buscar||'' %>" class="page-btn">
      <i class="fas fa-chevron-left"></i>
    </a>
  <% } %>
  <% for(let i = Math.max(1, pagination.current-2); i <= Math.min(pagination.total, pagination.current+2); i++) { %>
    <a href="?page=<%= i %>&estado=<%= filters.estado||'' %>&prioridad=<%= filters.prioridad||'' %>&canal=<%= filters.canal||'' %>&buscar=<%= filters.buscar||'' %>"
       class="page-btn <%= i === pagination.current ? 'active' : '' %>"><%= i %></a>
  <% } %>
  <% if (pagination.current < pagination.total) { %>
    <a href="?page=<%= pagination.current + 1 %>&estado=<%= filters.estado||'' %>&prioridad=<%= filters.prioridad||'' %>&canal=<%= filters.canal||'' %>&buscar=<%= filters.buscar||'' %>&periodo=<%= filters.periodo||'30' %>" class="page-btn">
      <i class="fas fa-chevron-right"></i>
    </a>
  <% } %>
  <span class="page-info"><%= pagination.count %> tickets</span>
</div>
<% } %>

<script>
const currentPeriodo = '<%= filters.periodo || "30" %>';
// Cargar gráficos
fetch('/api/stats?periodo=' + currentPeriodo).then(r=>r.json()).then(data => {
  const isDark = true;
  const textColor = '#94a3b8';
  const gridColor = '#1e293b';

  // Doughnut estado
  const estadoColors = { 'Pendiente':'#f59e0b','En Proceso':'#3b82f6','Resuelto':'#10b981','Cerrado':'#6b7280' };
  new Chart(document.getElementById('chartEstado'), {
    type: 'doughnut',
    data: {
      labels: data.estados.map(e => e.estado),
      datasets: [{ data: data.estados.map(e => e.total), backgroundColor: data.estados.map(e => estadoColors[e.estado] || '#64748b'), borderWidth: 0 }]
    },
    options: { plugins: { legend: { labels: { color: textColor } } }, cutout: '65%' }
  });

  // Bar prioridad
  const prioColors = { 'Urgente':'#ef4444','Alta':'#f97316','Media':'#3b82f6','Baja':'#10b981' };
  new Chart(document.getElementById('chartPrioridad'), {
    type: 'bar',
    data: {
      labels: data.prioridades.map(p => p.prioridad),
      datasets: [{ data: data.prioridades.map(p => p.total), backgroundColor: data.prioridades.map(p => prioColors[p.prioridad] || '#64748b'), borderRadius: 6, borderWidth: 0 }]
    },
    options: { plugins: { legend: { display: false } }, scales: { x: { ticks: { color: textColor }, grid: { color: gridColor } }, y: { ticks: { color: textColor }, grid: { color: gridColor } } } }
  });

  // Line tendencia
  new Chart(document.getElementById('chartTendencia'), {
    type: 'line',
    data: {
      labels: data.tendencia.map(t => new Date(t.semana).toLocaleDateString('es-AR', { day:'2-digit', month:'short' })),
      datasets: [{ label:'Tickets', data: data.tendencia.map(t => t.total), borderColor:'#3b82f6', backgroundColor:'rgba(59,130,246,0.1)', tension: 0.4, fill: true, pointBackgroundColor:'#3b82f6' }]
    },
    options: { plugins: { legend: { labels: { color: textColor } } }, scales: { x: { ticks: { color: textColor }, grid: { color: gridColor } }, y: { ticks: { color: textColor }, grid: { color: gridColor } } } }
  });

  if (data.canales?.length) {
    document.querySelector('[data-channel-strip]')?.remove();
    const strip = document.createElement('div');
    strip.className = 'channel-strip';
    strip.setAttribute('data-channel-strip', '1');
    strip.innerHTML = data.canales.map(item => `<span class="badge channel-badge canal-${item.canal}">${item.canal}: ${item.total}</span>`).join('');
    document.querySelector('.charts-row')?.after(strip);
  }
});
</script>

<!-- Modal Reporte Cliente -->
<div id="modalReporteCliente" class="modal-overlay" style="display:none" onclick="if(event.target===this)this.style.display='none'">
  <div class="modal-content modal-large">
    <div class="modal-header">
      <h3><i class="fas fa-file-export"></i> Enviar Reporte a Cliente</h3>
      <button type="button" class="modal-close" onclick="document.getElementById('modalReporteCliente').style.display='none'">&times;</button>
    </div>
    <div class="modal-body-split">
      <div class="modal-form-side">
        <form id="formReporteCliente" action="/tickets/enviar-reporte-cliente" method="POST">
          <div class="form-group">
            <label>Cliente</label>
            <select name="cliente_id" id="reporteClienteId" required class="form-select">
              <option value="">Seleccionar cliente...</option>
              <% clientes.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.nombre %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Período</label>
            <select name="periodo" id="reportePeriodo" class="form-select">
              <option value="7">Última semana (7 días)</option>
              <option value="30" selected>Último mes (30 días)</option>
              <option value="90">Últimos 3 meses (90 días)</option>
              <option value="365">Último año (365 días)</option>
            </select>
          </div>
          <div class="form-group">
            <label>Mensaje personalizado (opcional)</label>
            <textarea name="mensaje_personalizado" id="reporteMensaje" rows="4" class="form-textarea" placeholder="Hola, les compartimos el resumen de tickets del período..."></textarea>
          </div>
          <div class="modal-actions">
            <button type="button" class="btn-secondary" onclick="document.getElementById('modalReporteCliente').style.display='none'">Cancelar</button>
            <button type="button" class="btn-secondary" id="btnPreviewReporte"><i class="fas fa-eye"></i> Vista Previa</button>
            <button type="submit" class="btn-primary"><i class="fas fa-paper-plane"></i> Enviar</button>
          </div>
        </form>
      </div>
      <div class="modal-preview-side" id="previewContainer" style="display:none">
        <div class="preview-header">
          <strong>Vista Previa del Reporte</strong>
          <span id="previewInfo" class="text-muted"></span>
        </div>
        <iframe id="previewFrame" class="preview-frame" sandbox="allow-same-origin"></iframe>
      </div>
    </div>
  </div>
</div>

<script>
document.getElementById('btnPreviewReporte')?.addEventListener('click', async () => {
  const clienteId = document.getElementById('reporteClienteId').value;
  const periodo = document.getElementById('reportePeriodo').value;
  const mensaje = document.getElementById('reporteMensaje').value;
  const previewContainer = document.getElementById('previewContainer');
  const previewFrame = document.getElementById('previewFrame');
  const previewInfo = document.getElementById('previewInfo');

  if (!clienteId) {
    alert('Seleccioná un cliente primero');
    return;
  }

  previewInfo.textContent = 'Cargando...';
  previewContainer.style.display = 'block';

  try {
    const res = await fetch('/tickets/reporte-preview', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ cliente_id: clienteId, periodo, mensaje_personalizado: mensaje })
    });
    const data = await res.json();
    if (data.ok) {
      previewFrame.srcdoc = data.html;
      previewInfo.textContent = `${data.cliente} - ${data.periodo}`;
    } else {
      previewInfo.textContent = 'Error: ' + (data.error || 'Desconocido');
    }
  } catch (err) {
    previewInfo.textContent = 'Error de red';
  }
});
</script>

<%- include('../partials/footer') %>
