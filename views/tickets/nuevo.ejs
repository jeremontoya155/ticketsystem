<%- include('../partials/header') %>
<%
  const isClientUser = user.rol === 'cliente';
  const clientCompany = isClientUser ? clientes[0] : null;
%>

<div class="page-header">
  <div>
    <a href="/tickets" class="btn-back"><i class="fas fa-arrow-left"></i> Volver</a>
    <h1><i class="fas fa-plus-circle"></i> Nuevo Ticket</h1>
  </div>
</div>

<div class="form-container ticket-compose">
  <form action="/tickets/nuevo" method="POST" enctype="multipart/form-data" class="ticket-form" data-ticket-similar-form>
    <input type="hidden" name="creado_desde_mobile" value="0" data-mobile-ticket-flag>
    <% if (isClientUser) { %>
      <input type="hidden" name="cliente_id" value="<%= user.cliente_id || '' %>">
      <input type="hidden" name="canal_origen" value="web">
    <% } %>
    <div class="form-row">
      <div class="form-group">
        <label><i class="fas fa-building"></i> Empresa <span class="req">*</span></label>
        <% if (isClientUser) { %>
          <input type="text" class="form-input" value="<%= clientCompany ? clientCompany.nombre : 'Sin empresa asignada' %>" readonly>
          <% if (!clientCompany) { %>
            <small class="field-help text-warning">Tu usuario no tiene una empresa asociada. Pedi a un administrador que la configure.</small>
          <% } %>
        <% } else { %>
        <select name="cliente_id" required class="form-select">
          <option value="">Seleccionar empresa...</option>
          <% clientes.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.nombre %> (<%= c.nombre_tipo || 'Sin tipo' %>)</option>
          <% }) %>
        </select>
        <% } %>
      </div>
      <div class="form-group">
        <label><i class="fas fa-flag"></i> Prioridad <span class="req">*</span></label>
        <select name="prioridad" required class="form-select">
          <option value="Baja">Baja</option>
          <option value="Media" selected>Media</option>
          <option value="Alta">Alta</option>
          <option value="Urgente">Urgente</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <% if (!isClientUser) { %>
      <div class="form-group">
        <label><i class="fas fa-route"></i> Canal de origen</label>
        <select name="canal_origen" class="form-select">
          <option value="web" selected>Web</option>
          <option value="mail">Mail</option>
          <option value="whatsapp">WhatsApp</option>
          <option value="vfp">VFP</option>
        </select>
      </div>
      <% } %>
      <div class="form-group">
        <label><i class="fas fa-heading"></i> Asunto</label>
        <input type="text" name="asunto" placeholder="Resumen corto del caso" class="form-input" value="<%= ticket.asunto || '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label><i class="fas fa-envelope"></i> Email origen</label>
        <input type="email" name="origen_email" placeholder="cliente@empresa.com" class="form-input" value="<%= isClientUser ? user.email : '' %>">
      </div>
      <div class="form-group">
        <label><i class="fas fa-phone"></i> Telefono origen</label>
        <input type="text" name="origen_telefono" placeholder="+54 9..." class="form-input">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label><i class="fas fa-fingerprint"></i> Referencia externa</label>
        <input type="text" name="referencia_externa" placeholder="ID mail, comprobante, recepcion, etc." class="form-input">
      </div>
      <div class="form-group">
        <label><i class="fas fa-diagram-project"></i> Proceso</label>
        <select name="proceso" class="form-select">
          <option value="">Sin proceso especifico</option>
          <option value="soporte">Soporte</option>
          <option value="desarrollo">Desarrollo</option>
          <option value="recepcion">Recepcion</option>
          <option value="armado">Armado</option>
          <option value="operacion">Operacion</option>
        </select>
      </div>
    </div>

    <% if (!isClientUser) { %>
    <div class="form-row">
      <div class="form-group">
        <label><i class="fas fa-layer-group"></i> Bolsa inicial</label>
        <select name="bolsa_asignada" class="form-select">
          <option value="soporte" selected>Soporte</option>
          <option value="desarrollo">Desarrollo</option>
        </select>
      </div>
      <div class="form-group"></div>
    </div>
    <% } %>

    <% if (!isClientUser) { %>
    <div class="form-row">
      <div class="form-group">
        <label><i class="fas fa-user-check"></i> Receptor</label>
        <select name="receptor_id" class="form-select">
          <% usuarios.forEach(u => { %>
            <option value="<%= u.id %>" <%= u.id === user.id ? 'selected' : '' %>><%= u.nombre %> (<%= u.rol %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label><i class="fas fa-user-cog"></i> Ejecutor (Desarrollo)</label>
        <select name="ejecutor_id" class="form-select">
          <% usuarios.forEach(u => { %>
            <option value="<%= u.id %>" <%= u.id === user.id ? 'selected' : '' %>><%= u.nombre %> (<%= u.rol %>)</option>
          <% }) %>
        </select>
      </div>
    </div>
    <% } %>

    <div class="form-group">
      <label><i class="fas fa-exclamation-circle"></i> Reclamo / Descripcion <span class="req">*</span></label>
      <textarea name="reclamo" rows="5" placeholder="Describir detalladamente el problema o solicitud..." required class="form-textarea"><%= ticket.reclamo || '' %></textarea>
    </div>

    <div class="similar-warning" data-similar-warning hidden>
      <div class="similar-warning-title">
        <i class="fas fa-triangle-exclamation"></i>
        Posible tema ya ocupado
      </div>
      <p>Hay tickets abiertos parecidos para esta empresa. Revisalos por las dudas antes de cargar otro.</p>
      <div data-similar-list></div>
    </div>

    <% if (!isClientUser) { %>
    <div class="form-group">
      <label><i class="fas fa-comment-alt"></i> Observaciones</label>
      <textarea name="observacion" rows="3" placeholder="Notas internas, contexto adicional..." class="form-textarea"><%= ticket.observacion || '' %></textarea>
    </div>
    <% } %>

    <div class="form-row">
      <% if (!isClientUser) { %>
      <div class="form-group">
        <label><i class="fas fa-tag"></i> Estado inicial</label>
        <select name="estado" class="form-select">
          <option value="Pendiente" selected>Pendiente</option>
          <option value="En Proceso">En Proceso</option>
        </select>
      </div>
      <% } %>
      <div class="form-group">
        <label><i class="fas fa-image"></i> Imagenes</label>
        <input type="file" name="imagenes" accept="image/*" multiple class="form-input">
        <small class="field-help">Podes subir capturas o fotos. Maximo 8 imagenes de 5 MB.</small>
      </div>
    </div>

    <label class="checkbox-card">
      <input type="checkbox" name="notificar_creador_mail" <%= isClientUser ? 'checked' : '' %>>
      <span>
        <strong>Enviarme confirmacion por mail</strong>
        <small>Opcional. Se manda un resumen del ticket a <%= user.email %>.</small>
      </span>
    </label>

    <div class="form-actions">
      <a href="/tickets" class="btn-secondary">Cancelar</a>
      <button type="submit" class="btn-primary btn-lg">
        <i class="fas fa-save"></i> Crear Ticket
      </button>
    </div>
  </form>
</div>

<script>
  (() => {
    const mobileFlag = document.querySelector('[data-mobile-ticket-flag]');
    if (!mobileFlag) return;

    const isMobile = window.matchMedia('(max-width: 768px)').matches
      || /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);

    if (isMobile) {
      mobileFlag.value = '1';
    }
  })();

  (() => {
    const form = document.querySelector('[data-ticket-similar-form]');
    const warning = document.querySelector('[data-similar-warning]');
    const list = document.querySelector('[data-similar-list]');
    if (!form || !warning || !list) return;

    const clienteField = form.querySelector('[name="cliente_id"]');
    const asuntoField = form.querySelector('[name="asunto"]');
    const reclamoField = form.querySelector('[name="reclamo"]');
    let timer;

    const renderSimilarTickets = (tickets) => {
      if (!tickets.length) {
        warning.hidden = true;
        list.innerHTML = '';
        return;
      }

      warning.hidden = false;
      list.innerHTML = tickets.map((ticket) => `
        <a href="/tickets/${ticket.id}" target="_blank" class="similar-ticket-link">
          <strong>#${ticket.nro_ticket}</strong>
          <span>${ticket.asunto || 'Sin asunto'}</span>
          <small>${ticket.estado} - ${ticket.prioridad}</small>
        </a>
      `).join('');
    };

    const checkSimilarTickets = async () => {
      const clienteId = clienteField?.value;
      const asunto = asuntoField?.value || '';
      const reclamo = reclamoField?.value || '';

      if (!clienteId || `${asunto} ${reclamo}`.trim().length < 8) {
        renderSimilarTickets([]);
        return;
      }

      try {
        const params = new URLSearchParams({ cliente_id: clienteId, asunto, reclamo });
        const response = await fetch(`/api/tickets/similares?${params.toString()}`);
        const payload = await response.json();
        renderSimilarTickets(payload.ok ? payload.tickets : []);
      } catch (error) {
        console.error('No se pudieron consultar tickets similares:', error);
      }
    };

    [clienteField, asuntoField, reclamoField].forEach((field) => {
      field?.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(checkSimilarTickets, 450);
      });
      field?.addEventListener('change', checkSimilarTickets);
    });
  })();
</script>

<%- include('../partials/footer') %>
